NODE_ENV=development
# Production: NODE_ENV=production, AUTH_MODE=supabase and HTTPS origins required.
# See Docs/STAGE_4.md for the complete environment and security checklist.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Slow endpoint warnings; API errors remain error-level regardless of latency.
SLOW_REQUEST_MS=1000
# Optional: falls back to the host's local timezone if omitted.
APP_TIMEZONE=Asia/Kolkata
# Placeholder only: set your local password before first initialization.
DATABASE_URL=postgresql://kharcha:CHANGE_ME_LOCAL_ONLY@localhost:5432/kharcha
# Backend only. Leave blank to keep manual entry available without AI.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Use supabase for accounts. Local mode is only for the existing private local ledger.
AUTH_MODE=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
