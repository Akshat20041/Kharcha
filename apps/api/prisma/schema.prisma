generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  engineType          = "client"
}

enum TransactionType {
  expense
}

enum ExpenseNature {
  variable
  recurring_generated
}

enum SplitType {
  equal
}

enum Frequency {
  monthly
  weekly
  yearly
}

enum PaymentMethod {
  UPI
  CreditCard
  DebitCard
  Cash
  BankTransfer
  Wallet
  Other
}

model User {
  // Canonical identity: the Supabase UUID when authentication is connected.
  id                 String             @id @db.Uuid
  display_name       String             @default("") @db.VarChar(100)
  time_zone          String             @default("Asia/Kolkata") @db.VarChar(100)
  currency           String             @default("INR") @db.VarChar(3)
  created_at         DateTime           @default(now()) @db.Timestamptz(3)
  transactions       Transaction[]
  recurring_expenses RecurringExpense[]
  groq_api_usage     GroqApiUsage[]

  @@map("users")
}

// Shared system definitions. No user-created categories or category-write API.
model Category {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @unique @db.VarChar(100)
  created_at         DateTime           @default(now()) @db.Timestamptz(3)
  updated_at         DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  transactions       Transaction[]
  recurring_expenses RecurringExpense[]

  @@map("categories")
}

model Transaction {
  id                   String            @id @default(uuid()) @db.Uuid
  user_id              String            @db.Uuid
  user                 User              @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  transaction_type     TransactionType   @default(expense)
  expense_nature       ExpenseNature     @default(variable)
  total_amount         Decimal           @db.Decimal(14, 2)
  my_share             Decimal           @db.Decimal(14, 2)
  recoverable_amount   Decimal           @db.Decimal(14, 2)
  currency             String            @default("INR") @db.VarChar(3)
  description          String            @db.VarChar(500)
  merchant             String?           @db.VarChar(200)
  category_id          String            @db.Uuid
  category             Category          @relation(fields: [category_id], references: [id], onDelete: Restrict)
  subcategory          String?           @db.VarChar(100)
  notes                String?           @db.VarChar(5000)
  transaction_date     DateTime          @db.Date
  transaction_time     DateTime          @db.Time(0)
  time_zone            String            @db.VarChar(100)
  payment_method       PaymentMethod?
  is_split             Boolean           @default(false)
  participant_count    Int?
  split_type           SplitType?
  recurring_expense_id String?           @db.Uuid
  recurring_expense    RecurringExpense? @relation(fields: [recurring_expense_id, user_id], references: [id, user_id], onDelete: Restrict, onUpdate: NoAction)
  occurrence_date      DateTime?         @db.Date
  created_at           DateTime          @default(now()) @db.Timestamptz(3)
  updated_at           DateTime          @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([recurring_expense_id, occurrence_date])
  @@index([user_id, transaction_date(sort: Desc), transaction_time(sort: Desc), id(sort: Desc)])
  @@index([category_id])
  @@map("transactions")
}

model RecurringExpense {
  id                String        @id @default(uuid()) @db.Uuid
  user_id           String        @db.Uuid
  user              User          @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name              String        @db.VarChar(200)
  category_id       String        @db.Uuid
  category          Category      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  total_amount      Decimal       @db.Decimal(14, 2)
  my_share          Decimal       @db.Decimal(14, 2)
  currency          String        @default("INR") @db.VarChar(3)
  is_split          Boolean       @default(false)
  participant_count Int?
  frequency         Frequency
  start_date        DateTime      @db.Date
  end_date          DateTime?     @db.Date
  next_due_date     DateTime      @db.Date
  time_zone         String        @db.VarChar(100)
  is_active         Boolean       @default(true)
  notes             String?       @db.VarChar(5000)
  created_at        DateTime      @default(now()) @db.Timestamptz(3)
  updated_at        DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
  transactions      Transaction[]

  @@index([category_id])
  @@unique([id, user_id])
  @@index([user_id, is_active, next_due_date])
  @@map("recurring_expenses")
}

model GroqApiUsage {
  id                String   @id @default(uuid()) @db.Uuid
  user_id           String   @db.Uuid
  user              User     @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  created_at        DateTime @default(now()) @db.Timestamptz(3)
  model             String   @db.VarChar(100)
  outcome           String   @db.VarChar(30)
  http_status       Int?
  prompt_tokens     Int?
  completion_tokens Int?
  total_tokens      Int?
  duration_ms       Int

  @@index([user_id, created_at(sort: Desc)])
  @@map("groq_api_usage")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
