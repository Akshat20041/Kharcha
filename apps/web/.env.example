# Public browser-visible URL; never put database credentials here.
# Production: use HTTPS API/Supabase URLs and supabase mode; rebuild after changes.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Match the API mode. Only publishable/anon keys belong in the browser.
NEXT_PUBLIC_AUTH_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
